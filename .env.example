# Patch agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Ledger (leave CLICKHOUSE_URL empty to use runs/ledger.jsonl)
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Escalation call
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ONCALL_PHONE_NUMBER=

# Webhooks: the public tunnel to `trust serve`, and an optional shared secret
PUBLIC_BASE_URL=
TRUST_WEBHOOK_TOKEN=

# Loop tuning (defaults shown)
# TRUST_AGENT=openai            # or scripted; defaults to openai when OPENAI_API_KEY is set
# TRUST_MAX_PROOFS=2
# TRUST_MAX_ESCALATIONS=2
# TRUST_DECISION_TIMEOUT=600
# TRUST_SEMGREP_MCP=1           # 0 = Semgrep CLI only
